{"task_id": 7, "prompt": "Write a function to find all words which are at least 4 characters long in a string.", "samples": ["def test_find_char_long():\n\tassert find_char_long(\"This is a simple example text\") == [\"This\", \"simple\", \"example\", \"text\"]\nfind_char_long()", "def test_find_char_long():\n\tassert find_char_long ( \"This is a simple test string with severalwords and numbers123\" )\nfind_char_long()", "def test_find_char_long():\n\tassert find_char_long ( \"This is a sample sentence with severallongwords and short\" )\nfind_char_long()", "def test_find_char_long():\n\tassert find_char_long(\"This is a sample sentence with several long words\") == [\"This\", \"sample\", \"sentence\", \"several\", \"long\", \"words\"]\nfind_char_long()", "def test_find_char_long():\n\tassert find_char_long(\"This is a test string with several words\") == [\"This\", \"test\", \"string\", \"with\", \"several\", \"words\"]\nfind_char_long()", "def test_find_char_long():\n\tassert find_char_long ( \"The quick brown fox jumps over the lazy dog\" ) == [\"quick\", \"brown\", \"jumps\", \"over\", \"lazy\"]\nfind_char_long()", "def test_find_char_long():\n\tassert find_char_long ( \"This is a sample sentence with several longword and short\" )\nfind_char_long()", "def test_find_char_long():\n\tassert find_char_long(\"This is a sample sentence with several words\") == [\"This\", \"sample\", \"sentence\", \"with\", \"several\", \"words\"]\nfind_char_long()"]}
